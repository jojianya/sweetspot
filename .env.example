# Copy this file to .env and fill in real, unique values.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Public frontend origin. Production must use HTTPS.
SITE_URL=http://localhost:3000

# Public site origin used to build absolute links emailed to users
# (password reset). Never taken from request headers. Production must use
# the public https origin (same value as SITE_URL in this setup).
PUBLIC_BASE_URL=http://localhost:3000

# Outgoing mail for password reset: POSTs {"to","subject","text"} as JSON to
# this URL (Authorization: Bearer MAILER_WEBHOOK_KEY when set). Empty selects
# the log-only mailer (dev and tests); production refuses to boot without a
# webhook URL. Email provider: [FILL IN].
MAILER_WEBHOOK_URL=
MAILER_WEBHOOK_KEY=

# Public origin that serves the API's /uploads directory.
# Production must use a persistent volume and a non-local HTTPS origin.
STORAGE_BASE_URL=http://localhost:8081
APP_ENV=development

# Public MapTiler API key, inlined into the client bundle at build time.
# Used for basemap tiles and address geocoding. Restrict it to your domains
# (tiles/geocoding APIs only) in the MapTiler dashboard — never a full-access key.
NEXT_PUBLIC_MAPTILER_API_KEY=your-maptiler-key-here

# Browser-facing origin of the self-hosted vector tile server (the maps/
# module). In Docker this is the loopback-published TileServer GL port.
NEXT_PUBLIC_TILES_URL=http://localhost:8080
# Optional; defaults to http://localhost:8081.
# Browser-facing URL for client-side API calls. In Docker this is the
# loopback-published port; it is NOT used for SSR fetches.
NEXT_PUBLIC_API_URL=
# Server-to-server URL for SSR fetches inside the Docker network.
# In docker-compose this is http://server:8081 (the compose service name).
# If unset, the server falls back to NEXT_PUBLIC_API_URL and logs a warning —
# that fallback is wrong in Docker because localhost inside the client
# container is the container itself, not the host.
API_INTERNAL_URL=http://server:8081

# Maximum concurrent SSE connections (realtime /events endpoint).
# Defaults to 1000. Set to 0 or leave empty to use the default.
MAX_SSE_CONNECTIONS=1000

# SameSite attribute on the session cookie. One of: strict | lax
# Defaults to strict, which is the CSRF-safe choice. Set to lax ONLY when the
# browser reaches the app over plain HTTP on a LAN address (for example
# http://192.168.1.50:3000): SameSite=Strict is not sent on those requests, so
# the session cookie is silently dropped and you appear logged out. Leave it at
# strict for localhost and for any HTTPS deployment — lax still blocks
# cross-site POSTs, but it is a real (if small) reduction in CSRF hardening.
COOKIE_SAMESITE=strict

# Comma-separated list of browser origins allowed to call the API directly.
# The Next.js client proxies /api/* to the server, so the browser stays
# same-origin and this list is not load-bearing for the app. It exists so a
# developer can still hit the API from a browser on another origin (a scratch
# page, devtools) while debugging; curl and the Go tests are never subject to
# CORS. Set to "" to allow nothing. Add your LAN origin here, e.g.
# http://192.168.1.50:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated IPs or CIDRs of proxies allowed to set X-Forwarded-For
# (e.g. TRUSTED_PROXIES=172.18.0.0/16 for the compose bridge network).
# Empty (default) keeps today's behavior: the server uses the direct TCP peer
# as the client IP and ignores X-Forwarded-For, which is spoof-safe. It has no
# effect until the proxy actually forwards X-Forwarded-For — the Next.js
# /api/* rewrite currently does not, so per-IP rate limits stay shared per
# proxy until that changes. Never set 0.0.0.0/0 or ::/0: trusting every
# address lets any client spoof its IP and evade per-IP rate limits.
TRUSTED_PROXIES=

# Extra origins allowed to request the Next.js dev server, comma-separated.
# Next blocks cross-origin dev resources (notably the HMR WebSocket at
# /_next/hmr), so opening the app from a LAN address fails until that host is
# listed here. Hostnames only, no scheme or port; entries are normalized, so
# "http://192.168.1.50:3000" also works.
# Unset or empty falls back to localhost,127.0.0.1, which is what CI and
# `pnpm build` use. Not NEXT_PUBLIC_*: this is read by the dev server and has
# no reason to reach the browser bundle.
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# --- Production only (docker-compose.prod.yml) ---
# Public hostname served by nginx (certbot obtains ACME certificates).
DOMAIN=
# Sentry error tracking (empty keeps log-only behavior).
SENTRY_DSN=
SENTRY_ENV=production
# Postgres TLS and pool (see server/.env.example for details).
DATABASE_SSLMODE=require
DB_POOL_MAX_CONNS=10
DB_POOL_MAX_LIFETIME=30m
DB_POOL_MAX_IDLE=5m
DB_POOL_HEALTH_CHECK=1m
LOG_LEVEL=info
LOG_FORMAT=json
