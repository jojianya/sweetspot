# Production edge proxy. Only this service publishes ports; the app, API,
# Postgres and Redis live on the internal Docker network (see
# docker-compose.prod.yml) and are unreachable from the internet directly.
#
# Set DOMAIN in .env to the public hostname (Caddy obtains ACME certificates
# automatically; ports 80/443 must reach this host). Caddy redirects HTTP to
# HTTPS, so the HSTS header below is only ever served over HTTPS.
{$DOMAIN} {
	encode gzip

	# Caddy sets X-Forwarded-For and X-Forwarded-Proto on proxied requests by
	# default. The Go API only honors X-Forwarded-Proto from TRUSTED_PROXIES
	# (the compose subnet), so a spoofed header from the internet cannot flip
	# the session cookie's Secure flag.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# SSE stream: disable response buffering so pin events flush immediately.
	# The Next server rewrites /events to the Go API internally.
	handle /events {
		reverse_proxy client:3000 {
			flush_interval -1
		}
	}

	# Everything else (pages, static assets, /api/* rewrite) via Next.
	handle {
		reverse_proxy client:3000
	}
}
