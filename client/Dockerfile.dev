FROM node:20-alpine AS base
RUN npm install -g pnpm@10.28.0
WORKDIR /app

# Dependencies are installed at image-build time only; the source tree is
# bind-mounted at runtime so `next dev` hot-reloads edits without a rebuild.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY public ./public

EXPOSE 3000
CMD ["pnpm", "dev"]