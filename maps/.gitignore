# --- Large data & generated artifacts (never commit) ---
# Raw OSM extract (~579 MB) — provision with `curl -L -o data/philippines-latest.osm.pbf \
# https://download.geofabrik.de/asia/philippines-latest.osm.pbf`
data/*.osm.pbf

# Source data archives (external downloads, not for git)
data/sources/*.zip
data/sources/*.shp.zip
data/sources/*.sqlite.zip
data/tile_weights.tsv.gz

# Generated tile archive — see README
*.mbtiles
*.mbtiles.part

# Planetiler binary + cache, fetched on demand by build-tiles.sh
planetiler.jar
.planetiler-cache/

# Ad-hoc logs
*.log

# Dev test pages
dev/

# Playwright test scripts (dev only)
../client/playwright-*.mjs
