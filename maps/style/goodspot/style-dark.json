{
  "version": 8,
  "name": "GoodSpot247 Philippines (dark)",
  "metadata": {
    "goodspot247:schema": "shortbread-1.0",
    "goodspot247:source": "self-hosted TileServer GL (maps/philippines.mbtiles)",
    "goodspot247:attribution": "© OpenStreetMap contributors, ODbL 1.0"
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "center": [119.62, 12.95],
  "zoom": 5,
  "sources": {
    "philippines": {
      "type": "vector",
      "tiles": ["/data/philippines/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#1b1f24" }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "philippines",
      "source-layer": "land",
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["forest"],
          "#20301f",
          ["grass", "meadow", "village_green", "recreation_ground", "park", "garden", "golf_course", "playground", "miniature_golf", "orchard", "vineyard", "allotments", "plant_nursery", "greenhouse_horticulture", "farmland", "farmyard"],
          "#243026",
          ["sand", "beach", "heath", "scrub", "grassland", "bare_rock", "scree", "shingle"],
          "#2e2c25",
          ["swamp", "bog", "string_bog", "wet_meadow", "marsh"],
          "#1f2e2d",
          ["cemetery", "grave_yard"],
          "#22301f",
          ["residential"],
          "#262a2f",
          ["industrial", "commercial", "retail", "garages", "railway", "landfill", "brownfield", "greenfield", "quarry", "construction"],
          "#2a2e33",
          "#21252a"
        ]
      }
    },
    {
      "id": "water-polygons",
      "type": "fill",
      "source": "philippines",
      "source-layer": "water_polygons",
      "paint": { "fill-color": "#14293d" }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "philippines",
      "source-layer": "ocean",
      "paint": { "fill-color": "#14293d" }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "philippines",
      "source-layer": "water_lines",
      "paint": {
        "line-color": "#2f5f86",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 12, 0.9, 16, 2.4]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "philippines",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-color": "#33383e",
        "fill-outline-color": "#454b52"
      }
    },
    {
      "id": "street-casing",
      "type": "line",
      "source": "philippines",
      "source-layer": "streets",
      "minzoom": 12,
      "filter": ["match", ["get", "kind"], ["motorway", "trunk", "primary", "secondary"], true, false],
      "paint": {
        "line-color": "#12161a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.2, 14, 2.6, 18, 9],
        "line-gap-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 14, 2.2, 18, 8]
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "philippines",
      "source-layer": "streets",
      "paint": {
        "line-color": [
          "match",
          ["get", "kind"],
          ["motorway"],
          "#c56b4a",
          ["trunk"],
          "#c98a4a",
          ["primary"],
          "#d6a94e",
          ["secondary"],
          "#b99a56",
          ["tertiary"],
          "#8f8464",
          ["residential", "unclassified", "living_street"],
          "#6b7178",
          ["pedestrian"],
          "#5c6268",
          ["service", "track", "path", "footway", "cycleway", "steps", "bridleway"],
          "#4a5057",
          "#565c63"
        ],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          5, ["match", ["get", "kind"], ["motorway", "trunk"], 0.6, 0],
          7, ["match", ["get", "kind"], ["motorway", "trunk"], 0.9, ["primary"], 0.5, 0],
          9, ["match", ["get", "kind"], ["motorway", "trunk"], 1.3, ["primary"], 1.0, ["secondary", "tertiary"], 0.4, 0],
          10, ["match", ["get", "kind"], ["motorway", "trunk"], 1.6, ["primary"], 1.3, ["secondary", "tertiary"], 0.6, 0],
          12, ["match", ["get", "kind"], ["motorway", "trunk"], 2.6, ["primary"], 1.6, ["secondary", "tertiary"], 1.0, ["residential", "unclassified", "living_street", "pedestrian"], 0.5, 0],
          14, ["match", ["get", "kind"], ["motorway", "trunk"], 4.4, ["primary"], 3.6, ["secondary", "tertiary"], 3.0, ["residential", "unclassified", "living_street", "pedestrian"], 2.2, ["service", "track", "path", "footway", "cycleway", "steps", "bridleway"], 1.0, 0.3],
          18, ["match", ["get", "kind"], ["motorway", "trunk"], 16, ["primary"], 14, ["secondary", "tertiary"], 12, ["residential", "unclassified", "living_street", "pedestrian"], 10, ["service", "track", "path", "footway", "cycleway", "steps", "bridleway"], 5, 2]
        ]
      }
    },
    {
      "id": "railways",
      "type": "line",
      "source": "philippines",
      "source-layer": "streets",
      "minzoom": 9,
      "filter": ["==", ["get", "rail"], true],
      "paint": {
        "line-color": "#6b7075",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 14, 1.6],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "philippines",
      "source-layer": "boundaries",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#6d6257",
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.6, 6, 1.4, 12, 2.4],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "philippines",
      "source-layer": "boundaries",
      "minzoom": 7,
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#554d45",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 14, 1.6],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "philippines",
      "source-layer": "street_labels",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 18, 13],
        "text-padding": 2
      },
      "paint": {
        "text-color": "#b9b9b9",
        "text-halo-color": "#1b1f24",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "water-polygons-labels",
      "type": "symbol",
      "source": "philippines",
      "source-layer": "water_polygons_labels",
      "minzoom": 9,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 16, 14],
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#7fb0d8",
        "text-halo-color": "#1b1f24",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "water-lines-labels",
      "type": "symbol",
      "source": "philippines",
      "source-layer": "water_lines_labels",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#7fb0d8",
        "text-halo-color": "#1b1f24",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "philippines",
      "source-layer": "place_labels",
      "minzoom": 4,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, ["match", ["get", "kind"], ["capital"], 12, ["state_capital"], 11, 0],
          6, ["match", ["get", "kind"], ["capital"], 14, ["state_capital"], 13, ["city"], 11, 0],
          7, ["match", ["get", "kind"], ["capital"], 15, ["state_capital"], 14, ["city"], 12, ["town"], 10, 0],
          10, ["match", ["get", "kind"], ["capital"], 18, ["state_capital"], 16, ["city"], 14, ["town"], 12, ["village", "hamlet", "suburb", "quarter", "neighbourhood"], 10, 9],
          12, ["match", ["get", "kind"], ["capital"], 18, ["state_capital"], 16, ["city"], 16, ["town"], 13, ["village", "hamlet", "suburb", "quarter", "neighbourhood"], 11, 10],
          16, ["match", ["get", "kind"], ["capital"], 18, ["state_capital"], 16, ["city"], 16, ["town"], 15, ["village", "hamlet", "suburb", "quarter", "neighbourhood"], 13, 12]
        ],
        "text-variable-anchor": ["top", "bottom", "left", "right"],
        "text-radial-offset": 0.6,
        "text-padding": 4,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#e8e8e8",
        "text-halo-color": "#1b1f24",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "boundary-labels",
      "type": "symbol",
      "source": "philippines",
      "source-layer": "boundary_labels",
      "minzoom": 5,
      "filter": ["==", ["get", "admin_level"], 4],
      "layout": {
        "text-field": ["upcase", ["coalesce", ["get", "name"], ["get", "name_en"]]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 12, 14],
        "text-letter-spacing": 0.15,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#a29484",
        "text-halo-color": "#1b1f24",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "pois",
      "type": "symbol",
      "source": "philippines",
      "source-layer": "pois",
      "minzoom": 15,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-variable-anchor": ["top", "bottom", "left", "right"],
        "text-radial-offset": 0.4,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#c9c9c9",
        "text-halo-color": "#1b1f24",
        "text-halo-width": 1.1
      }
    }
  ]
}
