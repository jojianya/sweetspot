# Runtime
PORT=8081
APP_ENV=development

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=goodspotdb
# Postgres sslmode (disable, allow, prefer, require, verify-ca, verify-full).
# Stays disable for local dev; production refuses anything weaker than require.
# Generate the self-signed container cert with ./scripts/generate-db-certs.sh
# (private Docker network). If the database moves off-host, use verify-full
# with the provider's CA instead.
DATABASE_SSLMODE=disable
# Connection pool bounds (defaults suit a small single-host deployment).
DB_POOL_MAX_CONNS=10
DB_POOL_MAX_LIFETIME=30m
DB_POOL_MAX_IDLE=5m
DB_POOL_HEALTH_CHECK=1m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Storage
# Only local storage is implemented. Production requires a persistent volume
# mounted at ./uploads and a public HTTPS origin serving /uploads.
STORAGE_BACKEND=local
STORAGE_BASE_URL=http://localhost:8081

# Realtime
# Maximum concurrent SSE connections (realtime /events endpoint).
# Defaults to 1000. Set to 0 or leave empty to use the default.
MAX_SSE_CONNECTIONS=1000

# Public site origin for emailed links (password reset). Production must use
# the public https origin.
PUBLIC_BASE_URL=http://localhost:3000
# Outgoing mail: empty selects the log-only mailer (dev); production refuses
# to boot without a webhook URL. Email provider: [FILL IN].
MAILER_WEBHOOK_URL=
MAILER_WEBHOOK_KEY=

# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-* headers.
# Empty (default) uses the direct peer as the client IP (spoof-safe).
TRUSTED_PROXIES=
