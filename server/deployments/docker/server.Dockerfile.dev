FROM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS base
RUN apk add --no-cache vips-dev build-base pkgconf
WORKDIR /app

ENV CGO_ENABLED=1
ENV APP_ENV=development
ENV PATH="$PATH:/go/bin"

# Cache module downloads before copying source so rebuilds are fast.
COPY go.mod go.sum ./
RUN go mod download

# Hot-reload watcher for Go (rebuilds + restarts on file change).
RUN go install github.com/air-verse/air@latest

COPY . .

EXPOSE 8081
CMD ["air", "-c", ".air.toml"]