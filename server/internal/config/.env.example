# Runtime
PORT=8080
APP_ENV=development

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=goodspotdb

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=

# Error tracking (Sentry) — leave SENTRY_DSN empty to disable (log-only)
SENTRY_DSN=
SENTRY_ENV=development

# Storage
# Only local storage is implemented. Production requires a persistent volume
# mounted at ./uploads and a public HTTPS origin serving /uploads.
STORAGE_BACKEND=local
STORAGE_BASE_URL=http://localhost:8081
